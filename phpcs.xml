<?xml version="1.0"?>
<ruleset name="Lead Magnet Locker">
    <description>Project coding standards.</description>

    <!-- Base standard -->
    <rule ref="WordPress"/>

    <!-- Scan these folders -->
    <file>lead-magnet-locker.php</file>
