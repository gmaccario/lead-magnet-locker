<?xml version="1.0"?>
<ruleset name="Lead Magnet Locker">
    <description>Project coding standards.</description>

    <!-- Base standard -->
    <rule ref="WordPress"/>

    <!-- Scan these folders -->
    <file>lead-magnet-locker.php</file>
    <file>functions.php</file>
    <file>src</file>
    <file>views</file>

    <!-- Exclude third-party/vendor code -->
    <exclude-pattern>vendor/*</exclude-pattern>
    <exclude-pattern>node_modules/*</exclude-pattern>

    <!-- Classes follow PSR-4 file names (Composer autoloading). -->
    <rule ref="WordPress.Files.FileName">
        <exclude-pattern>lead-magnet-locker.php</exclude-pattern>
        <exclude-pattern>src/*</exclude-pattern>
    </rule>
</ruleset>
